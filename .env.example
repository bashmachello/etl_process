# Скопируйте этот файл в .env и заполните значения (.env в .gitignore).
# Секрет для подписи внутренних JWT Airflow — общий для всех контейнеров.
# Сгенерировать: uv run python -c 'import secrets; print(secrets.token_hex(64))'
AIRFLOW__API_AUTH__JWT_SECRET=change-me
